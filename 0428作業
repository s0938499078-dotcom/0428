import java.util.Scanner;

// Page 1: 機率的定義
class Page1 {
    void show(Scanner sc) {
        System.out.println("Page 1: Definition of Probability (機率的定義)");

        System.out.print("Enter favorable outcomes (事件A發生的個數): ");
        double favorable = sc.nextDouble();

        System.out.print("Enter total outcomes (全部可能情況): ");
        double total = sc.nextDouble();

        double result = favorable / total;

        System.out.println("Process: P(A) = 事件A發生的個數 / 全部可能情況");
        System.out.println("Process: P(A) = " + favorable + " / " + total);
        System.out.println("Result: P(A) = " + result);
        System.out.println("----------------------");
    }
}

// Page 2: 樣本空間
class Page2 {
    void show(Scanner sc) {
        System.out.println("Page 2: Sample Space (樣本空間)");

        System.out.print("Enter number of possible outcomes in S (所有可能結果的集合個數): ");
        int s = sc.nextInt();

        System.out.println("Process: S 意指所有可能結果的集合。");
        System.out.println("Result: n(S) = " + s);
        System.out.println("----------------------");
    }
}

// Page 3: 事件
class Page3 {
    void show(Scanner sc) {
        System.out.println("Page 3: Event (事件)");

        System.out.print("Enter number of outcomes in event A (我們關心的事件個數): ");
        int a = sc.nextInt();

        System.out.println("Process: A 意指我們關心的事件（例如：抽到建中學生）。");
        System.out.println("Result: n(A) = " + a);
        System.out.println("----------------------");
    }
}

// Page 4: 基本公式
class Page4 {
    void show(Scanner sc) {
        System.out.println("Page 4: Basic Formula (基本公式)");

        System.out.print("Enter n(A) (我要的): ");
        double a = sc.nextDouble();

        System.out.print("Enter n(S) (全部的): ");
        double s = sc.nextDouble();

        double result = a / s;

        System.out.println("Process: P(A) = n(A) / n(S) (口訣：我要的/全部的)");
        System.out.println("Process: P(A) = " + a + " / " + s);
        System.out.println("Result: P(A) = " + result);
        System.out.println("----------------------");
    }
}

// Page 5: 補事件
class Page5 {
    void show(Scanner sc) {
        System.out.println("Page 5: Complement (補事件)");

        System.out.print("Enter P(A) (事件A發生的機率): ");
        double pA = sc.nextDouble();

        double result = 1 - pA;

        System.out.println("Process: P(A^C) = 1 - P(A) (例如：不是建中的機率)");
        System.out.println("Process: P(A^C) = 1 - " + pA);
        System.out.println("Result: P(A^C) = " + result);
        System.out.println("----------------------");
    }
}

// Page 6: 聯集
class Page6 {
    void show(Scanner sc) {
        System.out.println("Page 6: Union OR (聯集)");

        System.out.print("Enter P(A): ");
        double pA = sc.nextDouble();

        System.out.print("Enter P(B): ");
        double pB = sc.nextDouble();

        System.out.print("Enter P(A intersection B) (A交集B): ");
        double pAB = sc.nextDouble();

        double result = pA + pB - pAB;

        System.out.println("Process: P(A U B) = P(A) + P(B) - P(A intersection B)");
        System.out.println("Process: P(A U B) = " + pA + " + " + pB + " - " + pAB);
        System.out.println("Result: P(A U B) = " + result);
        System.out.println("----------------------");
    }
}

// Page 7: 交集
class Page7 {
    void show(Scanner sc) {
        System.out.println("Page 7: Intersection AND (交集)");

        System.out.print("Enter P(A): ");
        double pA = sc.nextDouble();

        System.out.print("Enter P(B|A) (在A發生的條件下B發生的機率): ");
        double pBGivenA = sc.nextDouble();

        double result = pA * pBGivenA;

        System.out.println("Process: P(A intersection B) = P(A) * P(B|A)");
        System.out.println("Process: P(A intersection B) = " + pA + " * " + pBGivenA);
        System.out.println("Result: P(A intersection B) = " + result);
        System.out.println("----------------------");
    }
}

// Page 8: 條件機率
class Page8 {
    void show(Scanner sc) {
        System.out.println("Page 8: Conditional Probability (條件機率)");

        System.out.print("Enter P(A intersection B) (A交集B的機率): ");
        double pAB = sc.nextDouble();

        System.out.print("Enter P(B) (已知B發生的機率): ");
        double pB = sc.nextDouble();

        double result = pAB / pB;

        System.out.println("Process: P(A|B) = P(A intersection B) / P(B)");
        System.out.println("Process: P(A|B) = " + pAB + " / " + pB);
        System.out.println("Result: P(A|B) = " + result);
        System.out.println("----------------------");
    }
}

// Page 9: 獨立事件
class Page9 {
    void show(Scanner sc) {
        System.out.println("Page 9: Independent Events (獨立事件)");

        System.out.print("Enter P(A): ");
        double pA = sc.nextDouble();

        System.out.print("Enter P(B): ");
        double pB = sc.nextDouble();

        double result = pA * pB;

        System.out.println("Process: 若A、B獨立，P(A intersection B) = P(A) * P(B)");
        System.out.println("Process: P(A intersection B) = " + pA + " * " + pB);
        System.out.println("Result: P(A intersection B) = " + result);
        System.out.println("----------------------");
    }
}

// Page 10: 貝氏定理
class Page10 {
    void show(Scanner sc) {
        System.out.println("Page 10: Bayes Theorem (貝氏定理)");

        System.out.print("Enter P(B|A) (已知原因A，得到結果B的機率): ");
        double pBGivenA = sc.nextDouble();

        System.out.print("Enter P(A) (原因A的先前機率): ");
        double pA = sc.nextDouble();

        System.out.print("Enter P(B) (結果B的總機率): ");
        double pB = sc.nextDouble();

        double result = (pBGivenA * pA) / pB;

        System.out.println("Process: P(A|B) = P(B|A) * P(A) / P(B) (已知結果，反推原因)");
        System.out.println("Process: P(A|B) = " + pBGivenA + " * " + pA + " / " + pB);
        System.out.println("Result: P(A|B) = " + result);
        System.out.println("----------------------");
    }
}

// Page 11: 全機率公式
class Page11 {
    void show(Scanner sc) {
        System.out.println("Page 11: Total Probability Theorem (全機率公式)");

        System.out.print("Enter P(A|B1): ");
        double a1 = sc.nextDouble();

        System.out.print("Enter P(B1): ");
        double b1 = sc.nextDouble();

        System.out.print("Enter P(A|B2): ");
        double a2 = sc.nextDouble();

        System.out.print("Enter P(B2): ");
        double b2 = sc.nextDouble();

        double part1 = a1 * b1;
        double part2 = a2 * b2;
        double result = part1 + part2;

        System.out.println("Process: P(A) = Sigma P(A|Bi)P(Bi)");
        System.out.println("Process: P(A) = (" + a1 + " * " + b1 + ") + (" + a2 + " * " + b2 + ")");
        System.out.println("Process: P(A) = " + part1 + " + " + part2);
        System.out.println("Result: P(A) = " + result);
        System.out.println("----------------------");
    }
}

// Page 12: 學校例子
class Page12 {
    void show(Scanner sc) {
        System.out.println("Page 12: School Example (學校例子)");

        System.out.print("Enter J (建中人數): ");
        double j = sc.nextDouble();

        System.out.print("Enter B (北一女人數): ");
        double b = sc.nextDouble();

        System.out.print("Enter N (總人數): ");
        double n = sc.nextDouble();

        double pJ = j / n;
        double pB = b / n;

        System.out.println("Process: P(建中) = J / N = " + j + " / " + n);
        System.out.println("Result: P(建中) = " + pJ);
        System.out.println("Process: P(北一女) = B / N = " + b + " / " + n);
        System.out.println("Result: P(北一女) = " + pB);
        System.out.println("----------------------");
    }
}

// Page 13: 建中或北一女
class Page13 {
    void show(Scanner sc) {
        System.out.println("Page 13: J or B (建中或北一女)");

        System.out.print("Enter J (建中人數): ");
        double j = sc.nextDouble();

        System.out.print("Enter B (北一女人數): ");
        double b = sc.nextDouble();

        System.out.print("Enter N (總人數): ");
        double n = sc.nextDouble();

        double result = (j + b) / n;

        System.out.println("Process: P(建中 U 北一女) = (J + B) / N (因為兩者互斥)");
        System.out.println("Process: P(建中 U 北一女) = (" + j + " + " + b + ") / " + n);
        System.out.println("Result: P(建中 U 北一女) = " + result);
        System.out.println("----------------------");
    }
}

